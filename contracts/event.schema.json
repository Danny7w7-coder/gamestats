{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "event.schema.json",
  "title": "GameStats Event",
  "description": "Un evento de partida. `action` es un string libre: las acciones conocidas validan su `data`; una acción desconocida se acepta (Scala la guarda como UnknownAction). Los nombres de acción son únicos entre todos los juegos. Las reglas que dependen de otros eventos de la partida no caben en un schema: están en contracts/README.md (\"Validaciones de contexto\").",
  "type": "object",
  "required": ["eventId", "timestamp", "gameId", "gameVersion", "matchId", "type"],
  "properties": {
    "eventId":     { "type": "string", "minLength": 1 },
    "timestamp":   { "type": "string", "format": "date-time", "description": "RFC3339. El orden de los eventos se toma siempre de aquí." },
    "gameId":      { "enum": ["racing", "football", "fighting", "tetris"] },
    "gameVersion": { "type": "string", "minLength": 1 },
    "matchId":     { "type": "string", "minLength": 1 },
    "playerId":    { "type": "string", "minLength": 1 },
    "type": {
      "enum": [
        "MATCH_STARTED", "MATCH_FINISHED",
        "MATCH_PAUSED", "MATCH_RESUMED",
        "PLAYER_JOINED", "PLAYER_LEFT",
        "PLAYER_DISCONNECTED", "PLAYER_RECONNECTED",
        "PLAYER_ACTION"
      ]
    },
    "action": { "type": "string", "pattern": "^[A-Z][A-Z_]*$" },
    "data":   { "type": "object" }
  },
  "allOf": [
    {
      "if":   { "properties": { "type": { "not": { "enum": ["MATCH_STARTED", "MATCH_FINISHED", "MATCH_PAUSED", "MATCH_RESUMED"] } } } },
      "then": { "required": ["playerId"] }
    },
    {
      "if":   { "properties": { "type": { "const": "PLAYER_ACTION" } } },
      "then": { "required": ["action"] },
      "else": { "not": { "required": ["action"] } }
    },

    { "if": { "properties": { "type": { "const": "MATCH_PAUSED" } }, "required": ["type"] },
      "then": { "properties": { "data": { "$ref": "#/$defs/matchPaused" } } } },

    { "if": { "properties": { "gameId": { "const": "racing" },   "type": { "const": "MATCH_STARTED" } },  "required": ["gameId", "type"] },
      "then": { "required": ["data"], "properties": { "data": { "$ref": "#/$defs/racingMatchStarted" } } } },
    { "if": { "properties": { "gameId": { "const": "racing" },   "type": { "const": "MATCH_FINISHED" } }, "required": ["gameId", "type"] },
      "then": { "required": ["data"], "properties": { "data": { "$ref": "#/$defs/racingMatchFinished" } } } },
    { "if": { "properties": { "gameId": { "const": "football" }, "type": { "const": "MATCH_STARTED" } },  "required": ["gameId", "type"] },
      "then": { "required": ["data"], "properties": { "data": { "$ref": "#/$defs/footballMatchStarted" } } } },
    { "if": { "properties": { "gameId": { "const": "football" }, "type": { "const": "PLAYER_JOINED" } },  "required": ["gameId", "type"] },
      "then": { "required": ["data"], "properties": { "data": { "$ref": "#/$defs/footballPlayerJoined" } } } },
    { "if": { "properties": { "gameId": { "const": "fighting" }, "type": { "const": "MATCH_STARTED" } },  "required": ["gameId", "type"] },
      "then": { "required": ["data"], "properties": { "data": { "$ref": "#/$defs/fightingMatchStarted" } } } },
    { "if": { "properties": { "gameId": { "const": "fighting" }, "type": { "const": "PLAYER_JOINED" } },  "required": ["gameId", "type"] },
      "then": { "required": ["data"], "properties": { "data": { "$ref": "#/$defs/fightingPlayerJoined" } } } },
    { "if": { "properties": { "gameId": { "const": "tetris" },   "type": { "const": "MATCH_STARTED" } },  "required": ["gameId", "type"] },
      "then": { "required": ["data"], "properties": { "data": { "$ref": "#/$defs/tetrisMatchStarted" } } } },

    { "if": { "properties": { "action": { "const": "LAP_COMPLETED" } },     "required": ["action"] }, "then": { "required": ["data"], "properties": { "data": { "$ref": "#/$defs/lapCompleted" } } } },
    { "if": { "properties": { "action": { "const": "POSITION_CHANGED" } },  "required": ["action"] }, "then": { "required": ["data"], "properties": { "data": { "$ref": "#/$defs/positionChanged" } } } },
    { "if": { "properties": { "action": { "const": "OVERTAKE" } },          "required": ["action"] }, "then": { "required": ["data"], "properties": { "data": { "$ref": "#/$defs/overtake" } } } },
    { "if": { "properties": { "action": { "const": "LAPPED" } },            "required": ["action"] }, "then": { "required": ["data"], "properties": { "data": { "$ref": "#/$defs/lapped" } } } },
    { "if": { "properties": { "action": { "const": "ITEM_PICKUP" } },       "required": ["action"] }, "then": { "required": ["data"], "properties": { "data": { "$ref": "#/$defs/itemPickup" } } } },
    { "if": { "properties": { "action": { "const": "ITEM_USED" } },         "required": ["action"] }, "then": { "required": ["data"], "properties": { "data": { "$ref": "#/$defs/itemUsed" } } } },
    { "if": { "properties": { "action": { "const": "DRIFT" } },             "required": ["action"] }, "then": { "required": ["data"], "properties": { "data": { "$ref": "#/$defs/drift" } } } },
    { "if": { "properties": { "action": { "const": "COLLISION" } },         "required": ["action"] }, "then": { "required": ["data"], "properties": { "data": { "$ref": "#/$defs/collision" } } } },
    { "if": { "properties": { "action": { "const": "SPIN" } },              "required": ["action"] }, "then": { "required": ["data"], "properties": { "data": { "$ref": "#/$defs/lapCorner" } } } },
    { "if": { "properties": { "action": { "const": "RESPAWN" } },           "required": ["action"] }, "then": { "required": ["data"], "properties": { "data": { "$ref": "#/$defs/respawn" } } } },
    { "if": { "properties": { "action": { "const": "PENALTY" } },           "required": ["action"] }, "then": { "required": ["data"], "properties": { "data": { "$ref": "#/$defs/penalty" } } } },
    { "if": { "properties": { "action": { "const": "DNF" } },               "required": ["action"] }, "then": { "required": ["data"], "properties": { "data": { "$ref": "#/$defs/dnf" } } } },

    { "if": { "properties": { "action": { "const": "PASS" } },              "required": ["action"] }, "then": { "required": ["data"], "properties": { "data": { "$ref": "#/$defs/pass" } } } },
    { "if": { "properties": { "action": { "const": "SHOT" } },              "required": ["action"] }, "then": { "required": ["data"], "properties": { "data": { "$ref": "#/$defs/shot" } } } },
    { "if": { "properties": { "action": { "const": "GOAL" } },              "required": ["action"] }, "then": { "required": ["data"], "properties": { "data": { "$ref": "#/$defs/goal" } } } },
    { "if": { "properties": { "action": { "const": "FOUL" } },              "required": ["action"] }, "then": { "required": ["data"], "properties": { "data": { "$ref": "#/$defs/foul" } } } },
    { "if": { "properties": { "action": { "const": "SAVE" } },              "required": ["action"] }, "then": { "required": ["data"], "properties": { "data": { "$ref": "#/$defs/teamMinute" } } } },
    { "if": { "properties": { "action": { "const": "TACKLE" } },            "required": ["action"] }, "then": { "required": ["data"], "properties": { "data": { "$ref": "#/$defs/tackle" } } } },
    { "if": { "properties": { "action": { "const": "INTERCEPTION" } },      "required": ["action"] }, "then": { "required": ["data"], "properties": { "data": { "$ref": "#/$defs/teamMinute" } } } },
    { "if": { "properties": { "action": { "const": "CORNER" } },            "required": ["action"] }, "then": { "required": ["data"], "properties": { "data": { "$ref": "#/$defs/teamMinute" } } } },
    { "if": { "properties": { "action": { "const": "OFFSIDE" } },           "required": ["action"] }, "then": { "required": ["data"], "properties": { "data": { "$ref": "#/$defs/teamMinute" } } } },
    { "if": { "properties": { "action": { "const": "SUBSTITUTION" } },      "required": ["action"] }, "then": { "required": ["data"], "properties": { "data": { "$ref": "#/$defs/substitution" } } } },
    { "if": { "properties": { "action": { "const": "OWN_GOAL" } },          "required": ["action"] }, "then": { "required": ["data"], "properties": { "data": { "$ref": "#/$defs/teamMinute" } } } },
    { "if": { "properties": { "action": { "const": "PENALTY_KICK" } },      "required": ["action"] }, "then": { "required": ["data"], "properties": { "data": { "$ref": "#/$defs/penaltyKick" } } } },
    { "if": { "properties": { "action": { "const": "FREE_KICK" } },         "required": ["action"] }, "then": { "required": ["data"], "properties": { "data": { "$ref": "#/$defs/freeKick" } } } },
    { "if": { "properties": { "action": { "const": "THROW_IN" } },          "required": ["action"] }, "then": { "required": ["data"], "properties": { "data": { "$ref": "#/$defs/teamMinute" } } } },
    { "if": { "properties": { "action": { "const": "DRIBBLE" } },           "required": ["action"] }, "then": { "required": ["data"], "properties": { "data": { "$ref": "#/$defs/dribble" } } } },
    { "if": { "properties": { "action": { "const": "CLEARANCE" } },         "required": ["action"] }, "then": { "required": ["data"], "properties": { "data": { "$ref": "#/$defs/teamMinute" } } } },
    { "if": { "properties": { "action": { "const": "INJURY" } },            "required": ["action"] }, "then": { "required": ["data"], "properties": { "data": { "$ref": "#/$defs/injury" } } } },

    { "if": { "properties": { "action": { "const": "ATTACK" } },            "required": ["action"] }, "then": { "required": ["data"], "properties": { "data": { "$ref": "#/$defs/attack" } } } },
    { "if": { "properties": { "action": { "const": "SPECIAL_MOVE" } },      "required": ["action"] }, "then": { "required": ["data"], "properties": { "data": { "$ref": "#/$defs/specialMove" } } } },
    { "if": { "properties": { "action": { "const": "SUPER_MOVE" } },        "required": ["action"] }, "then": { "required": ["data"], "properties": { "data": { "$ref": "#/$defs/superMove" } } } },
    { "if": { "properties": { "action": { "const": "THROW" } },             "required": ["action"] }, "then": { "required": ["data"], "properties": { "data": { "$ref": "#/$defs/targetDamage" } } } },
    { "if": { "properties": { "action": { "const": "COMBO" } },             "required": ["action"] }, "then": { "required": ["data"], "properties": { "data": { "$ref": "#/$defs/combo" } } } },
    { "if": { "properties": { "action": { "const": "COUNTER_HIT" } },       "required": ["action"] }, "then": { "required": ["data"], "properties": { "data": { "$ref": "#/$defs/targetDamage" } } } },
    { "if": { "properties": { "action": { "const": "BLOCK" } },             "required": ["action"] }, "then": { "required": ["data"], "properties": { "data": { "$ref": "#/$defs/defense" } } } },
    { "if": { "properties": { "action": { "const": "PARRY" } },             "required": ["action"] }, "then": { "required": ["data"], "properties": { "data": { "$ref": "#/$defs/defense" } } } },
    { "if": { "properties": { "action": { "const": "KNOCKDOWN" } },         "required": ["action"] }, "then": { "required": ["data"], "properties": { "data": { "$ref": "#/$defs/targetRound" } } } },
    { "if": { "properties": { "action": { "const": "RECOVERY" } },          "required": ["action"] }, "then": { "required": ["data"], "properties": { "data": { "$ref": "#/$defs/roundOnly" } } } },
    { "if": { "properties": { "action": { "const": "STUN" } },              "required": ["action"] }, "then": { "required": ["data"], "properties": { "data": { "$ref": "#/$defs/stun" } } } },
    { "if": { "properties": { "action": { "const": "GUARD_BREAK" } },       "required": ["action"] }, "then": { "required": ["data"], "properties": { "data": { "$ref": "#/$defs/targetRound" } } } },
    { "if": { "properties": { "action": { "const": "METER_GAIN" } },        "required": ["action"] }, "then": { "required": ["data"], "properties": { "data": { "$ref": "#/$defs/meterGain" } } } },
    { "if": { "properties": { "action": { "const": "ROUND_WON" } },         "required": ["action"] }, "then": { "required": ["data"], "properties": { "data": { "$ref": "#/$defs/roundWon" } } } },

    { "if": { "properties": { "action": { "const": "PIECE_SPAWNED" } },     "required": ["action"] }, "then": { "required": ["data"], "properties": { "data": { "$ref": "#/$defs/pieceOnly" } } } },
    { "if": { "properties": { "action": { "const": "PIECE_MOVED" } },       "required": ["action"] }, "then": { "required": ["data"], "properties": { "data": { "$ref": "#/$defs/pieceMoved" } } } },
    { "if": { "properties": { "action": { "const": "PIECE_ROTATED" } },     "required": ["action"] }, "then": { "required": ["data"], "properties": { "data": { "$ref": "#/$defs/pieceRotated" } } } },
    { "if": { "properties": { "action": { "const": "SOFT_DROP" } },         "required": ["action"] }, "then": { "required": ["data"], "properties": { "data": { "$ref": "#/$defs/softDrop" } } } },
    { "if": { "properties": { "action": { "const": "HARD_DROP" } },         "required": ["action"] }, "then": { "required": ["data"], "properties": { "data": { "$ref": "#/$defs/hardDrop" } } } },
    { "if": { "properties": { "action": { "const": "HOLD" } },              "required": ["action"] }, "then": { "required": ["data"], "properties": { "data": { "$ref": "#/$defs/pieceOnly" } } } },
    { "if": { "properties": { "action": { "const": "PIECE_PLACED" } },      "required": ["action"] }, "then": { "required": ["data"], "properties": { "data": { "$ref": "#/$defs/piecePlaced" } } } },
    { "if": { "properties": { "action": { "const": "LINES_CLEARED" } },     "required": ["action"] }, "then": { "required": ["data"], "properties": { "data": { "$ref": "#/$defs/linesCleared" } } } },
    { "if": { "properties": { "action": { "const": "T_SPIN" } },            "required": ["action"] }, "then": { "required": ["data"], "properties": { "data": { "$ref": "#/$defs/tSpin" } } } },
    { "if": { "properties": { "action": { "const": "ALL_CLEAR" } },         "required": ["action"] }, "then": { "required": ["data"], "properties": { "data": { "$ref": "#/$defs/allClear" } } } },
    { "if": { "properties": { "action": { "const": "COMBO_BROKEN" } },      "required": ["action"] }, "then": { "required": ["data"], "properties": { "data": { "$ref": "#/$defs/comboBroken" } } } },
    { "if": { "properties": { "action": { "const": "LEVEL_UP" } },          "required": ["action"] }, "then": { "required": ["data"], "properties": { "data": { "$ref": "#/$defs/levelUp" } } } },
    { "if": { "properties": { "action": { "const": "SPEED_UP" } },          "required": ["action"] }, "then": { "required": ["data"], "properties": { "data": { "$ref": "#/$defs/speedUp" } } } },
    { "if": { "properties": { "action": { "const": "STACK_HEIGHT" } },      "required": ["action"] }, "then": { "required": ["data"], "properties": { "data": { "$ref": "#/$defs/stackHeight" } } } },
    { "if": { "properties": { "action": { "const": "GARBAGE_SENT" } },      "required": ["action"] }, "then": { "required": ["data"], "properties": { "data": { "$ref": "#/$defs/garbageSent" } } } },
    { "if": { "properties": { "action": { "const": "GARBAGE_RECEIVED" } },  "required": ["action"] }, "then": { "required": ["data"], "properties": { "data": { "$ref": "#/$defs/garbageReceived" } } } },
    { "if": { "properties": { "action": { "const": "TOP_OUT" } },           "required": ["action"] }, "then": { "required": ["data"], "properties": { "data": { "type": "object" } } } }
  ],
  "$defs": {
    "matchPaused":          { "type": "object", "properties": { "reason": { "type": "string" } } },

    "racingMatchStarted":   { "type": "object", "required": ["track", "laps"], "properties": { "track": { "type": "string" }, "laps": { "type": "integer", "minimum": 1 } } },
    "racingMatchFinished":  { "type": "object", "required": ["ranking"], "properties": { "ranking": { "type": "array", "items": { "type": "string" }, "minItems": 1 } } },
    "footballMatchStarted": { "type": "object", "required": ["homeTeam", "awayTeam"], "properties": { "homeTeam": { "type": "string" }, "awayTeam": { "type": "string" } } },
    "footballPlayerJoined": { "type": "object", "required": ["teamId"], "properties": { "teamId": { "type": "string" } } },
    "fightingMatchStarted": { "type": "object", "required": ["stage", "rounds"], "properties": { "stage": { "type": "string" }, "rounds": { "enum": [1, 3, 5], "description": "Máximo de rounds (mejor de N)." } } },
    "fightingPlayerJoined": { "type": "object", "required": ["character"], "properties": { "character": { "type": "string", "minLength": 1 } } },
    "tetrisMatchStarted":   { "type": "object", "required": ["mode", "startLevel"], "properties": { "mode": { "enum": ["marathon", "versus"] }, "startLevel": { "type": "integer", "minimum": 1, "maximum": 15 } } },

    "lap":     { "type": "integer", "minimum": 1, "description": "Contexto: no puede pasar de MATCH_STARTED.data.laps." },
    "minute":  { "type": "integer", "minimum": 0, "maximum": 130, "description": "Informativo; no se usa para ordenar." },
    "round":   { "type": "integer", "minimum": 1, "maximum": 5, "description": "Contexto: no puede pasar de MATCH_STARTED.data.rounds." },
    "piece":   { "enum": ["I", "O", "T", "S", "Z", "J", "L"] },
    "damage":  { "type": "integer", "minimum": 0, "maximum": 100 },
    "ref":     { "type": "string", "minLength": 1, "description": "playerId de otro jugador de la partida (contexto: distinto del que hace la acción)." },

    "lapCompleted":    { "type": "object", "required": ["lap", "lapTimeMs", "position"], "properties": { "lap": { "$ref": "#/$defs/lap" }, "lapTimeMs": { "type": "integer", "minimum": 1 }, "position": { "type": "integer", "minimum": 1 } } },
    "positionChanged": { "type": "object", "required": ["from", "to", "lap"], "properties": { "from": { "type": "integer", "minimum": 1 }, "to": { "type": "integer", "minimum": 1 }, "lap": { "$ref": "#/$defs/lap" } } },
    "penalty":         { "type": "object", "required": ["seconds", "reason"], "properties": { "seconds": { "type": "integer", "minimum": 0 }, "reason": { "type": "string" } } },
    "overtake":        { "type": "object", "required": ["lap", "overtakenId"], "properties": { "lap": { "$ref": "#/$defs/lap" }, "overtakenId": { "$ref": "#/$defs/ref" } } },
    "lapped":          { "type": "object", "required": ["lap", "lappedId"], "description": "playerId le saca una vuelta a lappedId.", "properties": { "lap": { "$ref": "#/$defs/lap" }, "lappedId": { "$ref": "#/$defs/ref" } } },
    "item":            { "enum": ["boost", "shield", "oil"] },
    "itemPickup":      { "type": "object", "required": ["lap", "item"], "properties": { "lap": { "$ref": "#/$defs/lap" }, "item": { "$ref": "#/$defs/item" } } },
    "itemUsed":        { "type": "object", "required": ["lap", "item"], "description": "boost = nitro (lleva durationMs); shield = escudo; oil = mancha de aceite.", "properties": { "lap": { "$ref": "#/$defs/lap" }, "item": { "$ref": "#/$defs/item" }, "durationMs": { "type": "integer", "minimum": 1 } },
                         "if": { "properties": { "item": { "const": "boost" } }, "required": ["item"] }, "then": { "required": ["durationMs"] } },
    "drift":           { "type": "object", "required": ["lap", "corner", "durationMs"], "properties": { "lap": { "$ref": "#/$defs/lap" }, "corner": { "type": "integer", "minimum": 1 }, "durationMs": { "type": "integer", "minimum": 1 } } },
    "collision":       { "type": "object", "required": ["lap", "otherId", "damage"], "properties": { "lap": { "$ref": "#/$defs/lap" }, "otherId": { "$ref": "#/$defs/ref" }, "damage": { "$ref": "#/$defs/damage" } } },
    "lapCorner":       { "type": "object", "required": ["lap", "corner"], "properties": { "lap": { "$ref": "#/$defs/lap" }, "corner": { "type": "integer", "minimum": 1 } } },
    "respawn":         { "type": "object", "required": ["lap", "position"], "properties": { "lap": { "$ref": "#/$defs/lap" }, "position": { "type": "integer", "minimum": 1 } } },
    "dnf":             { "type": "object", "required": ["lap", "reason"], "properties": { "lap": { "$ref": "#/$defs/lap" }, "reason": { "enum": ["crash", "mechanical", "disqualified"] } } },

    "pass":         { "type": "object", "required": ["teamId", "targetId", "success", "distance", "minute"], "properties": { "teamId": { "type": "string" }, "targetId": { "type": "string" }, "success": { "type": "boolean" }, "distance": { "type": "number", "minimum": 0 }, "minute": { "$ref": "#/$defs/minute" } } },
    "shot":         { "type": "object", "required": ["teamId", "onTarget", "minute"], "properties": { "teamId": { "type": "string" }, "onTarget": { "type": "boolean" }, "minute": { "$ref": "#/$defs/minute" } } },
    "goal":         { "type": "object", "required": ["teamId", "minute"], "properties": { "teamId": { "type": "string" }, "assistId": { "type": "string" }, "minute": { "$ref": "#/$defs/minute" } } },
    "foul":         { "type": "object", "required": ["teamId", "card", "minute"], "properties": { "teamId": { "type": "string" }, "card": { "enum": ["none", "yellow", "red"] }, "minute": { "$ref": "#/$defs/minute" }, "targetId": { "type": "string" } } },
    "teamMinute":   { "type": "object", "required": ["teamId", "minute"], "properties": { "teamId": { "type": "string" }, "minute": { "$ref": "#/$defs/minute" } } },
    "tackle":       { "type": "object", "required": ["teamId", "targetId", "success", "minute"], "properties": { "teamId": { "type": "string" }, "targetId": { "$ref": "#/$defs/ref" }, "success": { "type": "boolean" }, "minute": { "$ref": "#/$defs/minute" } } },
    "substitution": { "type": "object", "required": ["teamId", "inId", "minute"], "description": "playerId = el que sale; inId = el que entra.", "properties": { "teamId": { "type": "string" }, "inId": { "$ref": "#/$defs/ref" }, "minute": { "$ref": "#/$defs/minute" } } },
    "penaltyKick":  { "type": "object", "required": ["teamId", "scored", "minute"], "properties": { "teamId": { "type": "string" }, "scored": { "type": "boolean" }, "minute": { "$ref": "#/$defs/minute" } } },
    "freeKick":     { "type": "object", "required": ["teamId", "direct", "minute"], "properties": { "teamId": { "type": "string" }, "direct": { "type": "boolean" }, "minute": { "$ref": "#/$defs/minute" } } },
    "dribble":      { "type": "object", "required": ["teamId", "success", "minute"], "properties": { "teamId": { "type": "string" }, "success": { "type": "boolean" }, "minute": { "$ref": "#/$defs/minute" } } },
    "injury":       { "type": "object", "required": ["teamId", "severity", "minute"], "properties": { "teamId": { "type": "string" }, "severity": { "enum": ["minor", "major"] }, "minute": { "$ref": "#/$defs/minute" } } },

    "missMeansNoDamage": { "if": { "properties": { "hit": { "const": false } }, "required": ["hit"] }, "then": { "properties": { "damage": { "const": 0 } } } },
    "attack":       { "type": "object", "required": ["targetId", "move", "hit", "damage", "round"], "$ref": "#/$defs/missMeansNoDamage", "properties": { "targetId": { "$ref": "#/$defs/ref" }, "move": { "enum": ["punch", "kick"] }, "hit": { "type": "boolean" }, "damage": { "$ref": "#/$defs/damage" }, "round": { "$ref": "#/$defs/round" } } },
    "specialMove":  { "type": "object", "required": ["targetId", "name", "hit", "damage", "meterCost", "round"], "$ref": "#/$defs/missMeansNoDamage", "properties": { "targetId": { "$ref": "#/$defs/ref" }, "name": { "type": "string", "minLength": 1 }, "hit": { "type": "boolean" }, "damage": { "$ref": "#/$defs/damage" }, "meterCost": { "type": "integer", "minimum": 1, "maximum": 100 }, "round": { "$ref": "#/$defs/round" } } },
    "superMove":    { "type": "object", "required": ["targetId", "hit", "damage", "round"], "description": "Cuesta el medidor completo (100).", "$ref": "#/$defs/missMeansNoDamage", "properties": { "targetId": { "$ref": "#/$defs/ref" }, "hit": { "type": "boolean" }, "damage": { "$ref": "#/$defs/damage" }, "round": { "$ref": "#/$defs/round" } } },
    "targetDamage": { "type": "object", "required": ["targetId", "damage", "round"], "properties": { "targetId": { "$ref": "#/$defs/ref" }, "damage": { "type": "integer", "minimum": 1, "maximum": 100 }, "round": { "$ref": "#/$defs/round" } } },
    "combo":        { "type": "object", "required": ["targetId", "hits", "damage", "round"], "properties": { "targetId": { "$ref": "#/$defs/ref" }, "hits": { "type": "integer", "minimum": 2 }, "damage": { "type": "integer", "minimum": 1, "maximum": 100 }, "round": { "$ref": "#/$defs/round" } } },
    "defense":      { "type": "object", "required": ["attackerId", "round"], "properties": { "attackerId": { "$ref": "#/$defs/ref" }, "round": { "$ref": "#/$defs/round" } } },
    "roundOnly":    { "type": "object", "required": ["round"], "properties": { "round": { "$ref": "#/$defs/round" } } },
    "targetRound":  { "type": "object", "required": ["targetId", "round"], "properties": { "targetId": { "$ref": "#/$defs/ref" }, "round": { "$ref": "#/$defs/round" } } },
    "stun":         { "type": "object", "required": ["targetId", "durationMs", "round"], "properties": { "targetId": { "$ref": "#/$defs/ref" }, "durationMs": { "type": "integer", "minimum": 1 }, "round": { "$ref": "#/$defs/round" } } },
    "meterGain":    { "type": "object", "required": ["amount", "round"], "properties": { "amount": { "type": "integer", "minimum": 1, "maximum": 100 }, "round": { "$ref": "#/$defs/round" } } },
    "roundWon":     { "type": "object", "required": ["round", "remainingHealth", "method"], "properties": { "round": { "$ref": "#/$defs/round" }, "remainingHealth": { "type": "integer", "minimum": 1, "maximum": 100 }, "method": { "enum": ["ko", "timeout"] } } },

    "pieceOnly":       { "type": "object", "required": ["piece"], "properties": { "piece": { "$ref": "#/$defs/piece" } } },
    "pieceMoved":      { "type": "object", "required": ["direction"], "properties": { "direction": { "enum": ["left", "right"] } } },
    "pieceRotated":    { "type": "object", "required": ["direction"], "properties": { "direction": { "enum": ["cw", "ccw"] } } },
    "softDrop":        { "type": "object", "required": ["cells"], "properties": { "cells": { "type": "integer", "minimum": 1, "maximum": 20 } } },
    "hardDrop":        { "type": "object", "required": ["cells"], "properties": { "cells": { "type": "integer", "minimum": 0, "maximum": 20 } } },
    "piecePlaced":     { "type": "object", "required": ["piece", "hardDrop"], "properties": { "piece": { "$ref": "#/$defs/piece" }, "hardDrop": { "type": "boolean" } } },
    "linesCleared":    { "type": "object", "required": ["lines", "points", "combo"], "properties": { "lines": { "type": "integer", "minimum": 1, "maximum": 4 }, "points": { "type": "integer", "minimum": 0 }, "combo": { "type": "integer", "minimum": 0 } } },
    "tSpin":           { "type": "object", "required": ["lines"], "properties": { "lines": { "type": "integer", "minimum": 0, "maximum": 3 } } },
    "allClear":        { "type": "object", "required": ["lines"], "properties": { "lines": { "type": "integer", "minimum": 1, "maximum": 4 } } },
    "comboBroken":     { "type": "object", "required": ["combo"], "properties": { "combo": { "type": "integer", "minimum": 1 } } },
    "levelUp":         { "type": "object", "required": ["level"], "properties": { "level": { "type": "integer", "minimum": 2, "maximum": 30 } } },
    "speedUp":         { "type": "object", "required": ["gravity"], "properties": { "gravity": { "type": "number", "exclusiveMinimum": 0 } } },
    "stackHeight":     { "type": "object", "required": ["rows"], "properties": { "rows": { "type": "integer", "minimum": 0, "maximum": 20 } } },
    "garbageSent":     { "type": "object", "required": ["targetId", "lines"], "properties": { "targetId": { "$ref": "#/$defs/ref" }, "lines": { "type": "integer", "minimum": 1, "maximum": 12 } } },
    "garbageReceived": { "type": "object", "required": ["fromId", "lines"], "properties": { "fromId": { "$ref": "#/$defs/ref" }, "lines": { "type": "integer", "minimum": 1, "maximum": 12 } } }
  }
}
